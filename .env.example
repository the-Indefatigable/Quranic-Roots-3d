# QuRoots — environment variables
# Copy to .env.local and fill in. Never commit the filled-in file.

# ── Database (required) ──────────────────────────────────────────────
# Postgres connection string. Every page that reads content needs this.
DATABASE_URL=postgres://user:password@host:5432/quroots

# ── Auth (required) ──────────────────────────────────────────────────
# Read by NextAuth v5 directly (not via process.env in app code).
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — the only sign-in provider (src/lib/auth.ts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Site ─────────────────────────────────────────────────────────────
# Absolute base URL, no trailing slash. Used for OG images and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to unlock the Qirat (recitation) module in the UI.
NEXT_PUBLIC_UNLOCK_QIRAT=0

# Google Analytics measurement id, e.g. G-XXXXXXXXXX. Leave blank outside
# production so staging doesn't report into production analytics — with no id
# set, GA never loads and the consent banner never appears.
NEXT_PUBLIC_GA_ID=

# ── Payments (optional — donations / Founding Supporter) ─────────────
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in prod.
STRIPE_WEBHOOK_SECRET=

# ── Email digest (optional) ──────────────────────────────────────────
RESEND_API_KEY=
# From address for the weekly digest, e.g. "QuRoots <salam@quroots.com>"
DIGEST_FROM=

# ── Cron (optional) ──────────────────────────────────────────────────
# Shared secret for the three vercel.json cron routes. They fail closed
# when this is unset, so leave blank locally.
CRON_SECRET=
